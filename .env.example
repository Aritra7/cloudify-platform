# Dedalus AI Configuration
DEDALUS_API_KEY=your-dedalus-api-key-here

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your-claude-api-key-here

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Override default settings
LOG_LEVEL=INFO
DRY_RUN=false

# Go control plane (Terraform remains disabled unless explicitly enabled)
CLOUDIFY_DATABASE_URL=postgres://cloudify:cloudify@localhost:5432/cloudify?sslmode=disable
CLOUDIFY_TERRAFORM_ENABLED=false
CLOUDIFY_RECONCILER_ENABLED=false
CLOUDIFY_TERRAFORM_STATE_BUCKET=your-terraform-state-bucket
CLOUDIFY_TERRAFORM_ARTIFACT_ROOT=/durable/cloudify-plan-artifacts
# Base64 encoding of exactly 32 random bytes; load from a secret manager.
CLOUDIFY_TERRAFORM_ARTIFACT_KEY=replace-with-base64-key
# JSON records contain token SHA-256 digests, never plaintext bearer tokens.
CLOUDIFY_AUTH_TOKENS_JSON=[]
